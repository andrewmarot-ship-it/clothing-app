# Copy to .env.local for `npm run dev`; set the same keys in Vercel → Project → Settings → Environment Variables.
# Server-side only: never prefix these with VITE_.

# https://www.remove.bg/api — background removal
BG_REMOVAL_API_KEY=

# https://console.anthropic.com — garment tagging
ANTHROPIC_API_KEY=

# Optional: override the tagging model (default claude-haiku-5-5)
# TAG_MODEL=
