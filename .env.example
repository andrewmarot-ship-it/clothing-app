# Copy to .env.local for `npm run dev`; set the same keys as variables on the Railway service.
# Server-side only: never prefix these with VITE_.

# https://www.remove.bg/api — background removal
BG_REMOVAL_API_KEY=

# https://console.anthropic.com — garment tagging
ANTHROPIC_API_KEY=

# Sign-in and sync (Supabase). Both are public values, safe to ship in the client.
# Without them the app runs on this device only and photo processing needs no sign-in.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: override the tagging model (default claude-haiku-5-5)
# TAG_MODEL=

# Optional: photo-processing limits until sign-in exists (defaults 30 per client per hour, 300 per day overall)
# PHOTO_LIMIT_PER_HOUR=30
# PHOTO_LIMIT_PER_DAY=300
